# === Обязательные ===
# Golden key (токен) из настроек аккаунта FunPay:
#   FunPay -> Настройки -> API-ключ (golden key). Ровно 32 символа.
FUNPAY_GOLDEN_KEY=

# Токен Telegram-бота от @BotFather (если указан — TG-бот включится автоматически)
TELEGRAM_BOT_TOKEN=

# Секретный пароль для доступа к панели управления Telegram-ботом
TELEGRAM_SECRET_KEY=funpay

# === Необязательные ===
# User-agent (по умолчанию — Chrome 109 на Windows)
#FUNPAY_USER_AGENT=

# Автоподнятие лотов / автоответы / автовыдача: 1 или 0
#FUNPAY_AUTO_RAISE=0
#FUNPAY_AUTO_RESPONSE=0
#FUNPAY_AUTO_DELIVERY=0
#FUNPAY_MULTI_DELIVERY=0
#FUNPAY_AUTO_RESTORE=0
#FUNPAY_AUTO_DISABLE=0

# Задержка между запросами к FunPay (1-100, по умолчанию 4)
#FUNPAY_REQUESTS_DELAY=4

# Водяной знак в сообщениях
#FUNPAY_WATERMARK=[👾 FunPay Cardinal 👻]

# Прокси (если нужно)
#PROXY_ENABLE=0
#PROXY_IP=
#PROXY_PORT=
#PROXY_LOGIN=
#PROXY_PASSWORD=
#PROXY_CHECK=0
